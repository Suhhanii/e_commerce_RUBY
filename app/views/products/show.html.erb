<%= image_tag @product.featured_image if @product.featured_image.attached? %>

<% cache @product do %>
  <h1> <%= @product.name %></h1>
  <%= @product.description %>
<% end %>

<%# <%= link_to "Return To Home", product_path %>
<br/>
<% if authenticated? %>
  <p><%= link_to "Edit", edit_product_path(@product)%></p>
  <p><%= button_to "Delete", @product, method: :delete, data: {turbo_confirm: "Are you sure?"}%> </p>
<% end %>
